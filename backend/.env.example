# Copy to .env and fill in your Roboflow API key
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Optional: Google Maps Platform key with the "Places API (New)" enabled.
# Shows the nearest e-waste / battery / clothing drop-off spots. Without it the app
# shows a Google Maps search link instead.
GOOGLE_MAPS_API_KEY=

# Optional: Gemini API key (free at https://aistudio.google.com, no billing needed).
# Gives a second opinion on unclear scans, which fixes many wrong labels.
GEMINI_API_KEY=
